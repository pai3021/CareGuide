# Public template only. Runtime reads explicitly supplied process variables.
# Default BM25 works offline.
CAREGUIDE_RETRIEVAL_MODE=bm25
# Runtime defaults to the pinned open-data corpus.
CAREGUIDE_CORPUS_DIR=./data/careguide_kuake_rag_v1

# Optional real semantic embeddings: index explicitly before enabling dense/hybrid.
CAREGUIDE_EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
CAREGUIDE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
CAREGUIDE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
CAREGUIDE_EMBEDDING_DIMENSIONS=1024
CAREGUIDE_EMBEDDING_FORMAT=float
# Optional independent Chroma directory. Blank preserves ./data/chroma.
# Changing embedding models requires a separately built matching index.
CAREGUIDE_CHROMA_PATH=
# Optional exhaustive cosine search using cached indexed vectors. Loads all
# vectors in memory; ann remains default. Validate latency for the corpus size.
CAREGUIDE_DENSE_SEARCH=ann
# -1 disables a hard positive-score threshold. Calibrate rejection separately
# with answerable and unanswerable queries before raising it.
CAREGUIDE_MIN_DENSE_SCORE=-1.0
CAREGUIDE_RRF_DENSE_WEIGHT=4
CAREGUIDE_RRF_BM25_WEIGHT=1
CAREGUIDE_HYBRID_CANDIDATES=100
# Optional local BGE-M3 sparse leg. Build its complete document checkpoint offline.
# Requires the optional PyTorch/Transformers runtime (or transformer image).
# Both paths must be supplied; query handlers never download or build the model/index.
CAREGUIDE_BGE_SPARSE_MODEL_PATH=
CAREGUIDE_BGE_SPARSE_CHECKPOINT=
CAREGUIDE_HYBRID_FUSION=rrf
# Rank smoothing constant, independent of per-leg retrieval depth and rerank pool.
CAREGUIDE_RRF_CONSTANT=60
# Optional JSON weights override legacy RRF weights, e.g. dense/bm25/bge_sparse.
# Keys must exactly match enabled legs; zero disables that leg's query work.
CAREGUIDE_HYBRID_WEIGHTS=

# Dedicated cross-encoder reranker. A blank key reuses the embedding key.
CAREGUIDE_RERANK_API_KEY=
CAREGUIDE_RERANK_BASE_URL=https://api.siliconflow.cn/v1
CAREGUIDE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# Optional Qwen task instruction. Blank preserves the existing Chinese instruction.
CAREGUIDE_RERANK_INSTRUCTION=
CAREGUIDE_RERANK_CONCURRENCY=8
CAREGUIDE_RERANK_ENABLED=false
# Reranker input budget; final output size is the caller's top_k. 40 is opt-in.
CAREGUIDE_RERANK_CANDIDATES=20

# Independent chat configuration; no legacy .env is loaded.
CAREGUIDE_LLM_API_KEY=YOUR_LLM_API_KEY
CAREGUIDE_LLM_BASE_URL=https://api.xiaomimimo.com/v1
CAREGUIDE_LLM_MODEL=mimo-v2.6-flash
CAREGUIDE_INTENT_EMBEDDING_MODE=local_ngram
CAREGUIDE_INTENT_TAXONOMY=qic
# `fusion` preserves the lightweight runtime. `transformer` requires the
# optional requirements-transformer.txt packages and a fine-tuned local model.
CAREGUIDE_QIC_CLASSIFIER_BACKEND=fusion
CAREGUIDE_QIC_MODEL_PATH=D:/models/careguide-intent/best_model
CAREGUIDE_QIC_MODEL_DEVICE=auto
# Host-only path used by docker-compose.transformer.yml. The model directory is
# mounted read-only at CAREGUIDE_QIC_MODEL_PATH inside the container.
CAREGUIDE_QIC_MODEL_HOST_PATH=./models/careguide-intent-roberta-v1
# QIC remote mode uses local character TF-IDF + versioned Qwen centroids + rules.
# The LLM is called only below this fusion margin and can override only above
# the configured self-confidence. Set the margin to 0 to disable QIC LLM calls.
CAREGUIDE_QIC_LLM_GATE_MARGIN=0.40
CAREGUIDE_QIC_LLM_OVERRIDE_CONFIDENCE=0.95
# v3 predicts 21 fine tasks and enables synthetic hospital workflow routing.
# v2 predicts 15 fine tasks; v1 preserves the four-class baseline.
# Modes: disabled, local_ngram (legacy hash fallback), remote (real provider above).
CAREGUIDE_MAX_TOOL_ROUNDS=5
CAREGUIDE_MEMORY_MODE=session
# Optional three-tier backend; separate Redis namespace and Chroma collections.
CAREGUIDE_REDIS_URL=redis://127.0.0.1:6380/0
CAREGUIDE_CHROMA_HOST=127.0.0.1
CAREGUIDE_CHROMA_PORT=8002
CAREGUIDE_PERSIST_TRACES=false
CAREGUIDE_MEMORY_EMBEDDING_MODE=remote

# Embedded Chroma/BM25 is the default project path. WeKnora remains an optional
# knowledge-service adapter; when selected, failures never silently fall back.
CAREGUIDE_KNOWLEDGE_BACKEND=embedded
CAREGUIDE_WEKNORA_MCP_URL=
CAREGUIDE_WEKNORA_MCP_TOKEN=
CAREGUIDE_WEKNORA_SEARCH_TOOL=hybrid_search
CAREGUIDE_WEKNORA_KB_ID=

# Synthetic hospital only: disabled, memory, or fhir.
CAREGUIDE_HOSPITAL_BACKEND=memory
CAREGUIDE_FHIR_BASE_URL=http://127.0.0.1:8080/fhir
CAREGUIDE_FHIR_DB_PASSWORD=careguide-local-fhir
# Local handoff/knowledge/evaluation store; defaults to data/runtime/medical.sqlite3.
# CAREGUIDE_BUSINESS_DB=./data/runtime/medical.sqlite3
# Optional independent Judge; blank reuses the configured chat provider.
CAREGUIDE_JUDGE_API_KEY=
CAREGUIDE_JUDGE_BASE_URL=
CAREGUIDE_JUDGE_MODEL=

# unified: local rules + existing RoBERTa hints, composition/templates, then one
# dynamic understanding/planning decision for unresolved requests. No routing LLM.
# Local classifier reuses CAREGUIDE_QIC_MODEL_PATH / CAREGUIDE_QIC_MODEL_DEVICE.
# Missing local weights/dependencies abstain; scores cannot authorize execution.
# langgraph preserves the previous planner entry; direct keeps legacy routing.
CAREGUIDE_ORCHESTRATION_MODE=unified
# Optional server-bound bearer identity. The file contains token_sha256 hashes.
# Keep the file outside Git; mount it read-only when using containers.
CAREGUIDE_REQUIRE_AUTH=false
CAREGUIDE_AUTH_FILE=
# auto uses the existing embedding API only when its key and a chat Planner are
# configured. remote requires an embedding key; local_ngram keeps routing offline.
# Dense neighbours propose actions; scores alone cannot pass template admission.
CAREGUIDE_INTENT_SEMANTIC_MODE=auto
# parallel (default): fetch both sources, then use shared read-only admission.
# Optional on_demand skips retrieval after a classifier candidate plan is admitted.
CAREGUIDE_INTENT_SEMANTIC_POLICY=parallel
# Disable the legacy classifier to compare semantic-only candidates in unified mode.
CAREGUIDE_INTENT_CLASSIFIER_MODE=auto
# Bounded single-query candidate-to-template admission; disabled keeps Planner hints only.
CAREGUIDE_INTENT_CANDIDATE_ROUTING=read_only
CAREGUIDE_INTENT_SEMANTIC_TIMEOUT=3
# Optional prebuilt BUSINESS intent index (separate from medical RAG/QIC).
# CAREGUIDE_INTENT_SEMANTIC_INDEX=./data/runtime/business-intents-v1.json
CAREGUIDE_WORKFLOW_MODEL_CALLS=20
CAREGUIDE_WORKFLOW_TOOL_CALLS=30
CAREGUIDE_WORKFLOW_RETRIES=3
CAREGUIDE_WORKFLOW_REPLANS=3
CAREGUIDE_WORKFLOW_EXECUTION_SECONDS=120
CAREGUIDE_WORKFLOW_REQUEST_SECONDS=45

# Optional durable chat archive and token-based context management.
# Defaults preserve session-only behavior. TOKEN_CONTEXT requires SESSION_ARCHIVE=1.
CAREGUIDE_SESSION_ARCHIVE=0
CAREGUIDE_TOKEN_CONTEXT=0
CAREGUIDE_CONTEXT_WINDOW=32768
CAREGUIDE_CONTEXT_INPUT_CAP=24000
CAREGUIDE_CONTEXT_OUTPUT_RESERVE=2048
CAREGUIDE_CONTEXT_MARGIN=1024
CAREGUIDE_CONTEXT_TRIGGER_RATIO=0.85
CAREGUIDE_CONTEXT_TARGET_RATIO=0.60
# Exact model-name overrides, e.g. {"small-model":16384}; configure actual provider limits.
CAREGUIDE_CONTEXT_MODEL_WINDOWS={}
# 0 disables periodic review; 10 means every ten completed USER turns.
# Requires SESSION_ARCHIVE=1 and MEMORY_MODE=redis_chroma for the profile manager.
CAREGUIDE_MEMORY_REVIEW_INTERVAL=0
# Compatibility only. New preference writes use SQLite without Chroma projection.
CAREGUIDE_LEGACY_PROFILE_PROJECTION=0
