# Optional quality-oriented RAG profile, measured on a fixed 100-query dev pilot.
# Apply after the private .env; credentials and provider URLs remain there.
# Requires an existing corpus-matched Qwen embedding index. Never builds an index.
CAREGUIDE_RETRIEVAL_MODE=hybrid
CAREGUIDE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
CAREGUIDE_EMBEDDING_DIMENSIONS=1024
CAREGUIDE_MIN_DENSE_SCORE=-1.0
CAREGUIDE_HYBRID_CANDIDATES=100
CAREGUIDE_HYBRID_FUSION=rrf
CAREGUIDE_HYBRID_WEIGHTS=
CAREGUIDE_RRF_CONSTANT=60
CAREGUIDE_RRF_DENSE_WEIGHT=4
CAREGUIDE_RRF_BM25_WEIGHT=1
CAREGUIDE_BGE_SPARSE_MODEL_PATH=
CAREGUIDE_BGE_SPARSE_CHECKPOINT=
CAREGUIDE_RERANK_ENABLED=true
CAREGUIDE_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
CAREGUIDE_RERANK_INSTRUCTION=Rank the candidate passages by whether they can directly answer the Chinese medical query.
CAREGUIDE_RERANK_CANDIDATES=40
